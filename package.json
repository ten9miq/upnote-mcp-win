{
  "name": "@ten9miq/upnote-mcp-win",
  "version": "0.1.0",
  "description": "Windows UpNote MCP with CDP-based live editing, source-preserving partial edits, backups and sync acknowledgement checks.",
  "type": "module",
  "module": "src/index.ts",
  "bin": {
    "upnote-mcp-win": "src/index.ts"
  },
  "files": [
    "src",
    "scripts/start-upnote-bridge.ps1",
    "scripts/start-upnote-default.ps1",
    "scripts/upnote-default.vbs",
    "scripts/verify-upnote-cdp-owner.ts",
    "docs",
    "README.md",
    "README_ja.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "license": "MIT",
  "author": "ten9miq (https://github.com/ten9miq)",
  "contributors": ["bellx2 (https://github.com/bellx2)"],
  "keywords": ["upnote", "mcp", "windows", "cdp", "notes"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ten9miq/upnote-mcp-win.git"
  },
  "homepage": "https://github.com/ten9miq/upnote-mcp-win#readme",
  "bugs": {
    "url": "https://github.com/ten9miq/upnote-mcp-win/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "bun": ">=1.4.0"
  },
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "start": "bun run src/index.ts",
    "check": "tsc --noEmit",
    "test": "bun run scripts/run-tests.ts",
    "smoke": "bun run scripts/smoke.ts",
    "smoke:mcp": "bun run scripts/mcp-smoke.ts",
    "pack": "bun pm pack --destination dist",
    "build:mcpb": "bun run scripts/build-mcpb.ts",
    "prepublishOnly": "bun run check"
  },
  "devDependencies": {
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "entities": "^9.0.0",
    "htmlparser2": "^12.0.0",
    "zod": "^4.4.3"
  }
}
